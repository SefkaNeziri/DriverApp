
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF8F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <!-- Application name. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fancy Smart Parking"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#684858"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <!-- Welcome heading. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome Back"
            android:textSize="21sp"
            android:textColor="#B85C83"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log in to your parking account"
            android:textColor="#876C79"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <!-- Driver email. -->
        <EditText
            android:id="@+id/emailField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:minHeight="48dp"
            android:backgroundTint="#B85C83"
            android:layout_marginBottom="14dp"/>

        <!-- Driver password. -->
        <EditText
            android:id="@+id/passwordField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:minHeight="48dp"
            android:backgroundTint="#B85C83"
            android:layout_marginBottom="22dp"/>

        <!-- Login action. -->
        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Login"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B85C83"
            android:minHeight="48dp"/>

        <!-- Registration navigation. -->
        <TextView
            android:id="@+id/registerLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Don't have an account? Register"
            android:textColor="#A0446A"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Frontend Demo Mode"
            android:textSize="12sp"
            android:textColor="#876C79"
            android:gravity="center"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</ScrollView>
